# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# env files — never commit secrets
.env
.env*.local

# uploads and db dumps
/media
/backups

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# testing artifacts
/coverage
/test-results/
/playwright-report/
